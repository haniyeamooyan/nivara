generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  CTO
  MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum TeamStatus {
  ACTIVE
  INACTIVE
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum BudgetPeriodStatus {
  DRAFT
  OPEN
  LOCKED
  CLOSED
}

enum AllocationSource {
  TEAM_DEFAULT
  INDIVIDUAL_OVERRIDE
}

enum TeamBudgetAllocationStatus {
  DRAFT
  CONFIRMED
}

enum BudgetAccountOwnerType {
  USER
  TEAM
}

enum BudgetTransactionType {
  ALLOCATION
  CARRY_OVER
  PURCHASE_DEBIT
  ADJUSTMENT
}

enum PurchaseRequestStatus {
  SUBMITTED
  PURCHASED
  REJECTED
  CANCELLED
}

enum PlanStatus {
  ACTIVE
  RENEWED
  EXPIRED
}

enum RenewalStatus {
  AUTO
  MANUAL
  NOT_RENEWING
  NOT_APPLICABLE
}

enum RenewalRequestStatus {
  SUBMITTED
  ACKNOWLEDGED
  CANCELLED
}

enum NotificationType {
  BUDGET_ALLOCATION
  EXPIRY_REMINDER
  RENEWAL_REQUEST
  SYSTEM
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  role         UserRole
  status       UserStatus @default(ACTIVE)
  deletedAt    DateTime?  @map("deleted_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  managedTeams                   Team[]                 @relation("TeamManager")
  sessions                       Session[]
  memberships                    TeamMembership[]
  allocations                    BudgetAllocation[]     @relation("AllocationUser")
  confirmedAllocations           BudgetAllocation[]     @relation("AllocationConfirmer")
  confirmedTeamBudgetAllocations TeamBudgetAllocation[] @relation("TeamBudgetConfirmer")
  createdBudgetTransactions      BudgetTransaction[]    @relation("BudgetTransactionCreator")
  budgetAccounts                 BudgetAccount[]
  purchaseRequests               PurchaseRequest[]      @relation("RequestRequester")
  purchases                      Purchase[]             @relation("PersonalPurchases")
  madePurchases                  Purchase[]             @relation("PurchaseBuyer")
  renewalRequests                RenewalRequest[]       @relation("RenewalRequester")
  notifications                  Notification[]
  auditLogs                      AuditLog[]

  @@index([role, status])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Team {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  managerId String     @map("manager_id") @db.Uuid
  status    TeamStatus @default(ACTIVE)
  deletedAt DateTime?  @map("deleted_at")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  manager           User                   @relation("TeamManager", fields: [managerId], references: [id])
  memberships       TeamMembership[]
  allocations       BudgetAllocation[]
  budgetAllocations TeamBudgetAllocation[]
  accounts          BudgetAccount[]
  requests          PurchaseRequest[]
  purchases         Purchase[]

  @@unique([name])
  @@index([managerId])
  @@map("teams")
}

model TeamMembership {
  id       String    @id @default(uuid()) @db.Uuid
  teamId   String    @map("team_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([userId, leftAt])
  @@index([teamId, leftAt])
  @@map("team_memberships")
}

model Service {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  category  String?
  status    ServiceStatus @default(ACTIVE)
  deletedAt DateTime?     @map("deleted_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  requests  PurchaseRequest[]
  purchases Purchase[]

  @@unique([name])
  @@index([status])
  @@map("services")
}

model BudgetPeriod {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  startsAt  DateTime           @map("starts_at")
  endsAt    DateTime           @map("ends_at")
  status    BudgetPeriodStatus @default(DRAFT)
  createdAt DateTime           @default(now()) @map("created_at")
  lockedAt  DateTime?          @map("locked_at")

  allocations     BudgetAllocation[]
  teamAllocations TeamBudgetAllocation[]
  transactions    BudgetTransaction[]

  @@unique([startsAt])
  @@index([status, startsAt])
  @@map("budget_periods")
}

model TeamBudgetAllocation {
  id            String                     @id @default(uuid()) @db.Uuid
  periodId      String                     @map("period_id") @db.Uuid
  teamId        String                     @map("team_id") @db.Uuid
  defaultAmount Decimal                    @map("default_amount") @db.Decimal(12, 2)
  status        TeamBudgetAllocationStatus @default(DRAFT)
  confirmedBy   String?                    @map("confirmed_by") @db.Uuid
  confirmedAt   DateTime?                  @map("confirmed_at")
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")

  period      BudgetPeriod       @relation(fields: [periodId], references: [id])
  team        Team               @relation(fields: [teamId], references: [id])
  confirmer   User?              @relation("TeamBudgetConfirmer", fields: [confirmedBy], references: [id])
  allocations BudgetAllocation[]

  @@unique([periodId, teamId])
  @@index([teamId, status])
  @@map("team_budget_allocations")
}

model BudgetAllocation {
  id                     String           @id @default(uuid()) @db.Uuid
  periodId               String           @map("period_id") @db.Uuid
  teamId                 String           @map("team_id") @db.Uuid
  userId                 String           @map("user_id") @db.Uuid
  teamBudgetAllocationId String           @map("team_budget_allocation_id") @db.Uuid
  amount                 Decimal          @db.Decimal(12, 2)
  carriedAmount          Decimal          @default(0) @map("carried_amount") @db.Decimal(12, 2)
  source                 AllocationSource
  confirmedBy            String?          @map("confirmed_by") @db.Uuid
  confirmedAt            DateTime?        @map("confirmed_at")
  createdAt              DateTime         @default(now()) @map("created_at")

  period               BudgetPeriod         @relation(fields: [periodId], references: [id])
  team                 Team                 @relation(fields: [teamId], references: [id])
  user                 User                 @relation("AllocationUser", fields: [userId], references: [id])
  confirmer            User?                @relation("AllocationConfirmer", fields: [confirmedBy], references: [id])
  teamBudgetAllocation TeamBudgetAllocation @relation(fields: [teamBudgetAllocationId], references: [id])

  @@unique([periodId, userId])
  @@index([teamId, periodId])
  @@map("budget_allocations")
}

model BudgetAccount {
  id        String                 @id @default(uuid()) @db.Uuid
  ownerType BudgetAccountOwnerType @map("owner_type")
  userId    String?                @unique @map("user_id") @db.Uuid
  teamId    String?                @unique @map("team_id") @db.Uuid
  createdAt DateTime               @default(now()) @map("created_at")

  user         User?               @relation(fields: [userId], references: [id])
  team         Team?               @relation(fields: [teamId], references: [id])
  transactions BudgetTransaction[]

  @@map("budget_accounts")
}

model BudgetTransaction {
  id            String                @id @default(uuid()) @db.Uuid
  accountId     String                @map("account_id") @db.Uuid
  periodId      String?               @map("period_id") @db.Uuid
  type          BudgetTransactionType
  amount        Decimal               @db.Decimal(12, 2)
  referenceType String?               @map("reference_type")
  referenceId   String?               @map("reference_id") @db.Uuid
  description   String?
  createdBy     String                @map("created_by") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at")

  account BudgetAccount @relation(fields: [accountId], references: [id])
  period  BudgetPeriod? @relation(fields: [periodId], references: [id])
  creator User          @relation("BudgetTransactionCreator", fields: [createdBy], references: [id])

  @@index([accountId, createdAt])
  @@index([periodId, type])
  @@map("budget_transactions")
}

model PurchaseRequest {
  id              String                @id @default(uuid()) @db.Uuid
  requesterId     String                @map("requester_id") @db.Uuid
  teamId          String                @map("team_id") @db.Uuid
  serviceId       String                @map("service_id") @db.Uuid
  requestedAmount Decimal               @map("requested_amount") @db.Decimal(12, 2)
  note            String?
  status          PurchaseRequestStatus @default(SUBMITTED)
  rejectionReason String?               @map("rejection_reason")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  requester User      @relation("RequestRequester", fields: [requesterId], references: [id])
  team      Team      @relation(fields: [teamId], references: [id])
  service   Service   @relation(fields: [serviceId], references: [id])
  purchase  Purchase?

  @@index([teamId, status])
  @@index([requesterId, status])
  @@map("purchase_requests")
}

model Purchase {
  id                   String        @id @default(uuid()) @db.Uuid
  requestId            String?       @unique @map("request_id") @db.Uuid
  teamId               String?       @map("team_id") @db.Uuid
  userId               String?       @map("user_id") @db.Uuid
  serviceId            String        @map("service_id") @db.Uuid
  actualAmount         Decimal       @map("actual_amount") @db.Decimal(12, 2)
  companyAmount        Decimal       @map("company_amount") @db.Decimal(12, 2)
  employeeContribution Decimal       @map("employee_contribution") @db.Decimal(12, 2)
  renewedFromId        String?       @unique @map("renewed_from_id") @db.Uuid
  startDate            DateTime      @map("start_date") @db.Date
  endDate              DateTime?     @map("end_date") @db.Date
  planStatus           PlanStatus    @default(ACTIVE) @map("plan_status")
  renewalStatus        RenewalStatus @map("renewal_status")
  note                 String?
  purchasedBy          String        @map("purchased_by") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  request         PurchaseRequest? @relation(fields: [requestId], references: [id])
  team            Team?            @relation(fields: [teamId], references: [id])
  user            User?            @relation("PersonalPurchases", fields: [userId], references: [id])
  service         Service          @relation(fields: [serviceId], references: [id])
  buyer           User             @relation("PurchaseBuyer", fields: [purchasedBy], references: [id])
  renewalRequests RenewalRequest[]
  renewedFrom     Purchase?        @relation("PurchaseRenewals", fields: [renewedFromId], references: [id])
  renewedInto     Purchase?        @relation("PurchaseRenewals")

  @@index([teamId, createdAt])
  @@index([userId, planStatus])
  @@index([endDate, planStatus])
  @@map("purchases")
}

model RenewalRequest {
  id          String               @id @default(uuid()) @db.Uuid
  purchaseId  String               @map("purchase_id") @db.Uuid
  requestedBy String               @map("requested_by") @db.Uuid
  status      RenewalRequestStatus @default(SUBMITTED)
  note        String?
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  purchase  Purchase @relation(fields: [purchaseId], references: [id])
  requester User     @relation("RenewalRequester", fields: [requestedBy], references: [id])

  @@index([purchaseId, status])
  @@map("renewal_requests")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  type        NotificationType
  title       String
  body        String
  dedupeKey   String?          @unique @map("dedupe_key")
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  recipient User @relation(fields: [recipientId], references: [id])

  @@index([recipientId, readAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
